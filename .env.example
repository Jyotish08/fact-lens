# Live is the default when all partner credentials are configured. Use "mock"
# only for deterministic tests and offline demos.
VOICECLAIM_SERVICE_MODE=live

# Use a long, random value in every shared environment.
VOICECLAIM_SESSION_SIGNING_SECRET=replace-with-at-least-32-random-characters

SPEECHMATICS_API_KEY=
SPEECHMATICS_REALTIME_URL=wss://global.rt.speechmatics.com/v2
SPEECHMATICS_BATCH_URL=https://asr.api.speechmatics.com

BRIGHTDATA_API_TOKEN=
BRIGHTDATA_MCP_URL=https://mcp.brightdata.com/mcp

OPENAI_API_KEY=
VOICECLAIM_FAST_MODEL=gpt-4o-mini
VOICECLAIM_SYNTHESIS_MODEL=gpt-4o
VOICECLAIM_EMBEDDING_MODEL=text-embedding-3-small
